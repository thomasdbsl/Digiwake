// structure pour les notes (les frequences) et les durées de ces notes
struct Note
{
  uint16_t frequence; // en Hz
  uint16_t duree;     // en ms
};

// memoire temp
Note melodieActive[nb_note];
int nbNotesActive = 0;

// charger la melodie de la memoire EEPROM
void chargerMelodieEEPROM(int adresseDebut, Note *melodie, int &nbNotes)
{
  nbNotes = 0;
  for (int i = 0; i < nb_note; i++)
  {
    EEPROM.get(adresseDebut + i * sizeof(Note), melodie[i]);
    if (melodie[i].frequence == 0 && melodie[i].duree == 0)
    {
      break;
    }
    nbNotes++;
  }
}

// charger la mélodie en fonction du du choix de l'utilisateur
void chargerMelodieActive()
{
  if (melodie_choisie == 1)
  {
    chargerMelodieEEPROM(adr_melo1, melodieActive, nbNotesActive);
  }
  else if (melodie_choisie == 2)
  {
    chargerMelodieEEPROM(adr_melo2, melodieActive, nbNotesActive);
  }
}

// jouer melodie depuis la memoire active
void jouerMelodieEEPROM()
{
  unsigned long temps_ecoule = millis() - debut_buzzer;
  int index = (temps_ecoule / melodieActive[0].duree) % nbNotesActive;
  tone(buzzer, melodieActive[index].frequence);
}

// sauvegarde melodies dans la memoire EEPROM
void sauvegarderMelodieEEPROM(int adresseDebut, Note *melodie, int nbNotes)
{
  for (int i = 0; i < nbNotes; i++)
  {
    EEPROM.put(adresseDebut + i * sizeof(Note), melodie[i]);
  }
}

// initialisation de la memoire EEPROM (melodies)
void initialiserEEPROM()
{
  Note melodie1[nb_note] = {{1000, 250}, {1200, 250}, {1400, 250}, {1600, 250}};
  Note melodie2[nb_note] = {{500, 300}, {1600, 300}, {900, 300}, {1100, 300}};
  sauvegarderMelodieEEPROM(adr_melo1, melodie1, nb_note);
  sauvegarderMelodieEEPROM(adr_melo2, melodie2, nb_note);
}

// problemes d'affichage matrices alors rotation
void afficherChiffre(int matrice, int chiffre)
{
  for (int col = 0; col < 8; col++)
  {
    byte colonneOriginale = chiffres[chiffre][col];
    byte colonneMiroir = 0;

    // rotation miroir
    for (int bit = 0; bit < 8; bit++)
    {
      if (colonneOriginale & (1 << bit))
      {
        colonneMiroir |= (1 << (7 - bit));
      }
    }

    lc.setColumn(matrice, col, colonneMiroir);
  }
}

// les deux points sur les matrices
void afficherDeuxPoints(bool etat)
{
  // point 1 : ligne 5, colonne 0
  lc.setLed(2, 5, 6, etat);
  // point 2 : ligne 6, colonne 0
  lc.setLed(2, 2, 6, etat);
}

void gererClignotementDeuxPoints()
{
  unsigned long maintenant = millis();

  // changer d'état toute les 0,5 sec (500ms)
  if (maintenant - dernierClignotement >= 500)
  {
    dernierClignotement += 500;       // ajouter 500ms
    dernierClignotement = maintenant; // chrono remis a 0
    etatPoints = !etatPoints;         // changement d'état

    // maj de l'affichage des 2 points
    afficherDeuxPoints(etatPoints);
  }
}

// initialisations des matrices leds
void initialiserMatrices()
{
  for (int i = 0; i < 4; i++)
  {
    lc.shutdown(i, false);  // mdoe eco energie OFF
    lc.setIntensity(i, 10); // luminosité (egale a 10 dans notre cas)
    lc.clearDisplay(i);     // reset de l'affichage initial
  }
}

// initialisation RTC
void initialiserRTC()
{
  if (!rtc.begin())
  {
    while (1)
      ; // si RTC pas detecter alors on bloque
  }

  if (!rtc.isrunning())
  {
    rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));
  }
}

void afficherHeureMatrices(int heure, int minute)
{
  int heureAffichee = heure;

  if (!format_24h)
  { // cas quand le format est AM
    if (heure == 0)
    {
      heureAffichee = 12; // s'il est minuit alors on affiche 12h
    }
    else if (heure > 12)
    {
      heureAffichee = heure - 12; // conversion de l'heure en format 12h
    }
  }

  int heureDizaines = heureAffichee / 10;
  int heureUnites = heureAffichee % 10;
  int minuteDizaines = minute / 10;
  int minuteUnites = minute % 10;

  afficherChiffre(0, minuteUnites);   // matrice 1 : unités des minutes
  afficherChiffre(1, minuteDizaines); // matrice 2 : dizaines des minutes
  afficherChiffre(2, heureUnites);    // matrice 3 : unités des heures
  afficherChiffre(3, heureDizaines);  // matrice 4 : dizaines des heures
}

long lireDistance()
{
  digitalWrite(cap_trig, LOW);
  delayMicroseconds(2);
  digitalWrite(cap_trig, HIGH);
  delayMicroseconds(10);
  digitalWrite(cap_trig, LOW);

  long duree = pulseIn(cap_echo, HIGH, 20000); // TO a 20ms
  if (duree == 0)
  {
    return 999; // si aucun signal recu alors distance invalide
  }

  long distance = duree * 0.034 / 2; // conversion de la distance en cm
  return distance;
}

void setup()
{
  u8g.setColorIndex(1); // couleur blanche
  Serial.begin(9600);
  initialiserEEPROM();                  // initialiser l'EEPROM
  initialiserMatrices();                // initialiser les matrices
  initialiserRTC();                     // initialiser le RTC
  pinMode(Bouton_haut, INPUT_PULLUP);   // configurer le bouton haut
  pinMode(Bouton_choix, INPUT_PULLUP);  // configurer le bouton choix
  pinMode(Bouton_bas, INPUT_PULLUP);    // configurer le bouton bas
  pinMode(Bouton_retour, INPUT_PULLUP); // configurer le bouton retour
  pinMode(bouton_stop, INPUT_PULLUP);   // configurer le bouton stop
  pinMode(led, OUTPUT);                 // Configurer la broche LED comme sortie
  digitalWrite(led, LOW);               // Assurer que la LED est éteinte au démarrage
  pinMode(cap_trig, OUTPUT);            // def broche trig comme sortie
  pinMode(cap_echo, INPUT);             // def broche echo comme entrée
  pinMode(buzzer, OUTPUT);              // def broche buzzer comme sortie
  digitalWrite(buzzer, LOW);            // desactiver le buzzer au demarrage
}

void loop()
{
  DateTime now = rtc.now();
  int heureActuelle = now.hour();
  int minuteActuelle = now.minute();

  // gestion du clignotement des points
  gererClignotementDeuxPoints();

  if (format_24h)
  {
    afficherHeureMatrices(heureActuelle, minuteActuelle);
  }
  else
  {
    int heure12h = (heureActuelle % 12 == 0) ? 12 : heureActuelle % 12;
    afficherHeureMatrices(heure12h, minuteActuelle);
  }

  // réveil
  if (reveil_active && heureActuelle == heure_reveil && minuteActuelle == minute_reveil && !buzzer_en_cours && !reveil_deja_sonne)
  {
    buzzer_en_cours = true;
    reveil_deja_sonne = true;
    debut_buzzer = millis();
    chargerMelodieActive();
  }

  // jouer la mélodie
  // Jouer la mélodie
  if (buzzer_en_cours)
  {
    unsigned long temps_ecoule = millis() - debut_buzzer;
    unsigned long maintenant = millis();

    // LED du reveil qui clignote
    if (maintenant - dernier_clignotement >= intervalle_clignotement)
    {
      dernier_clignotement = maintenant;
      led_etat = !led_etat;        // changement d'état de la LED
      digitalWrite(led, led_etat); // maj de l'état de la LED
    }

    // si bouton stop appuyer
    if (digitalRead(bouton_stop) == LOW && bouton_stop_cliquer == 0)
    {
      bouton_stop_cliquer = 1;
      buzzer_en_cours = false; // changement d'état du buzzer
      noTone(buzzer);          // buzzer sans son
      digitalWrite(led, LOW);  // eteindre la LED
    }
    // snooze si detection de la main (5cm)
    else if (lireDistance() <= 5)
    {
      buzzer_en_cours = false; // etat du buzzer
      alarme_reportee = true;  // snooze reportee ou pas (false ou true)
      noTone(buzzer);          // plus de buzzer
      digitalWrite(led, LOW);  // éteindre la LED
    }
    // sinon jouer 10 sec
    else if (temps_ecoule < 10000)
    {
      jouerMelodieEEPROM();
    }
    // apres apres les 10 sec
    else
    {
      buzzer_en_cours = false;
      noTone(buzzer);
      digitalWrite(led, LOW);
    }
  }

  // reset de l'état du bouton après appui
  if (digitalRead(bouton_stop) == HIGH && bouton_stop_cliquer == 1)
  {
    bouton_stop_cliquer = 0;
  }

  // si snooze alors on ajoute du temps au réveil
  if (alarme_reportee)
  {
    alarme_reportee = false;                  // état du snooze
    minute_reveil = (minute_reveil + 1) % 60; // ajout du temps pour relancer l'alarme
  }

  if (heureActuelle != heure_reveil || minuteActuelle != minute_reveil)
  {
    reveil_deja_sonne = false;
  }

  // bouton stop
  if (buzzer_en_cours)
  {

    // Si le bouton stop est pressé
    if (digitalRead(bouton_stop) == LOW && bouton_stop_cliquer == 0)
    {
      bouton_stop_cliquer = 1;
      buzzer_en_cours = false; // desactiver buzze
      noTone(buzzer);          // arret buzzer
    }
  }
  // reset bouton après appui
  if (digitalRead(bouton_stop) == HIGH && bouton_stop_cliquer == 1)
  {
    bouton_stop_cliquer = 0;
  }

  // bouton retour
  if ((digitalRead(Bouton_retour) == LOW) && (Bouton_retour_cliquer == 0))
  {
    Bouton_retour_cliquer = 1;
    if (mode_editer_heure) // mode edition
    {
      mode_editer_heure = false; // quitter mode édition
      actuel = 0;                // revenir menu principal
    }
    else if (actuel > 0)
    {
      actuel--; // revenir l'état précédent (menu principal ou sous menu)
    }
  }
  if ((digitalRead(Bouton_retour) == HIGH) && (Bouton_retour_cliquer == 1))
  {
    Bouton_retour_cliquer = 0;
  }

  // menu principal
  if (actuel == 0 && !mode_editer_heure)
  {
    if ((digitalRead(Bouton_haut) == LOW) && (Bouton_haut_cliquer == 0))
    {
      choix_select = (choix_select - 1 + nb_choix) % nb_choix;
      Bouton_haut_cliquer = 1;
    }
    if ((digitalRead(Bouton_bas) == LOW) && (Bouton_bas_cliquer == 0))
    {
      choix_select = (choix_select + 1) % nb_choix;
      Bouton_bas_cliquer = 1;
    }
    if ((digitalRead(Bouton_choix) == LOW) && (Bouton_choix_cliquer == 0))
    {
      actuel = 1; // sous-menu
      sous_menu_actuel = choix_select;
      sous_choix_select = 0; // reset du sous-menu
      Bouton_choix_cliquer = 1;
    }
  }
  else if (actuel == 1)
  {
    if (mode_editer_heure)
    {
      // gestion l'édition d'heure
      if ((digitalRead(Bouton_haut) == LOW) && (Bouton_haut_cliquer == 0))
      {
        heure_modifiee = (heure_modifiee + 1) % 24;
        Bouton_haut_cliquer = 1;
      }
      if ((digitalRead(Bouton_bas) == LOW) && (Bouton_bas_cliquer == 0))
      {
        minute_modifiee = (minute_modifiee + 1) % 60;
        Bouton_bas_cliquer = 1;
      }
      if ((digitalRead(Bouton_choix) == LOW) && (Bouton_choix_cliquer == 0))
      {
        if (sous_menu_actuel == 0)
        { // sous menu "Heure"
          rtc.adjust(DateTime(now.year(), now.month(), now.day(), heure_modifiee, minute_modifiee, 0));
        }
        else if (sous_menu_actuel == 3)
        { // sous menu "Heure Réveil"
          heure_reveil = heure_modifiee;
          minute_reveil = minute_modifiee;
        }
        mode_editer_heure = false; // quitter le mode edition
        actuel = 0;                // revenir menu principal
        Bouton_choix_cliquer = 1;
      }
    }
    else
    {
      // gestion des sous-menus
      int nb_choix_sous_menu = nb_sous_choix[sous_menu_actuel];

      if ((digitalRead(Bouton_haut) == LOW) && (Bouton_haut_cliquer == 0))
      {
        sous_choix_select = (sous_choix_select - 1 + nb_choix_sous_menu) % nb_choix_sous_menu;
        Bouton_haut_cliquer = 1;
      }
      if ((digitalRead(Bouton_bas) == LOW) && (Bouton_bas_cliquer == 0))
      {
        sous_choix_select = (sous_choix_select + 1) % nb_choix_sous_menu;
        Bouton_bas_cliquer = 1;
      }

      if ((digitalRead(Bouton_choix) == LOW) && (Bouton_choix_cliquer == 0))
      {
        if (sous_menu_actuel == 5)
        { // sous menu "Format"
          if (sous_choix_select == 0)
          {
            format_24h = false; // 12h
          }
          else if (sous_choix_select == 1)
          {
            format_24h = true; // 24h
          }
        }
        else if (sous_menu_actuel == 4)
        { // sous menu "Durée alarme"
          if (sous_choix_select == 0)
          {
            duree_snooze = 1; // 1 minute
          }
          else if (sous_choix_select == 1)
          {
            duree_snooze = 5; // 5 minutes
          }
        }
        else if (sous_menu_actuel == 2)
        { // sous menu "Réveil"
          if (sous_choix_select == 0)
          {
            reveil_active = true; // cctiver réveil
          }
          else if (sous_choix_select == 1)
          {
            reveil_active = false; // désactiver réveil
          }
        }
        else if (sous_menu_actuel == 0 || sous_menu_actuel == 3)
        {
          // activer mode édition "Heure" ou "Heure Réveil"
          mode_editer_heure = true;
          heure_modifiee = (sous_menu_actuel == 0) ? now.hour() : heure_reveil;
          minute_modifiee = (sous_menu_actuel == 0) ? now.minute() : minute_reveil;
        }
        else if (sous_menu_actuel == 1)
        {                                          // sous menu "Alarme"
          melodie_choisie = sous_choix_select + 1; // choix melodie
        }
        Bouton_choix_cliquer = 1;
      }
    }
  }

  // reset les appui des boutons
  if ((digitalRead(Bouton_haut) == HIGH) && (Bouton_haut_cliquer == 1))
    Bouton_haut_cliquer = 0;
  if ((digitalRead(Bouton_bas) == HIGH) && (Bouton_bas_cliquer == 1))
    Bouton_bas_cliquer = 0;
  if ((digitalRead(Bouton_choix) == HIGH) && (Bouton_choix_cliquer == 1))
    Bouton_choix_cliquer = 0;
  if ((digitalRead(Bouton_retour) == HIGH) && (Bouton_retour_cliquer == 1))
    Bouton_retour_cliquer = 0;

  // affichage (avec u8glib)
  u8g.firstPage();
  do
  {
    if (mode_editer_heure)
    {
      char buffer[6];
      sprintf(buffer, "%02d:%02d", heure_modifiee, minute_modifiee);
      u8g.drawStr(30, 30, buffer);
    }
    else if (actuel == 0)
    { // menu principal
      u8g.drawBitmapP(15, 21, 113 / 8, 20, rectangle_select);
      u8g.setFont(u8g_font_7x14);
      u8g.drawStr(25, 15, menu_choix[(choix_select - 1 + nb_choix) % nb_choix]);
      u8g.setFont(u8g_font_7x14B);
      u8g.drawStr(25, 35, menu_choix[choix_select]);
      u8g.setFont(u8g_font_7x14);
      u8g.drawStr(25, 55, menu_choix[(choix_select + 1) % nb_choix]);

      // Annotation ON OFF pour le reveil
      u8g.setFont(u8g_font_6x10);
      if (reveil_active)
      {
        u8g.drawStr(0, 10, "ON"); // si réveil activé
      }
      else
      {
        u8g.drawStr(0, 10, "OFF"); // si réveil désactivé
      }

      // annotation AM PM pour le format
      u8g.setFont(u8g_font_6x10);
      if (!format_24h)
      {
        u8g.drawStr(0, 60, "AM"); // si le format est 12h
      }
      else
      {
        u8g.drawStr(0, 60, "PM"); // si le format est 24h
      }
    }
    else if (actuel == 1)
    { // Sous menu
      char(*sous_menu)[taille] = (char(*)[taille])sous_menus[sous_menu_actuel];
      int nb_choix_sous_menu = nb_sous_choix[sous_menu_actuel];
      u8g.drawBitmapP(15, 21, 113 / 8, 20, rectangle_select);

      if (nb_choix_sous_menu == 1)
      {
        u8g.setFont(u8g_font_7x14B);
        u8g.drawStr(25, 35, sous_menu[0]);
      }
      else if (nb_choix_sous_menu == 2)
      {
        u8g.setFont(u8g_font_7x14);
        u8g.drawStr(25, 15, sous_menu[(sous_choix_select == 0) ? 1 : 0]);
        u8g.setFont(u8g_font_7x14B);
        u8g.drawStr(25, 35, sous_menu[sous_choix_select]);
      }
    }
  } while (u8g.nextPage());
}
