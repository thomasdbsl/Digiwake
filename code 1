// Fonction pour afficher un chiffre sur une matrice avec rotation miroir
void afficherChiffre(int matrice, int chiffre) {
  for (int col = 0; col < 8; col++) {
    byte colonneOriginale = chiffres[chiffre][col];
    byte colonneMiroir = 0;

    // Inverser les bits pour une rotation miroir
    for (int bit = 0; bit < 8; bit++) {
      if (colonneOriginale & (1 << bit)) {
        colonneMiroir |= (1 << (7 - bit));
      }
    }

    lc.setColumn(matrice, col, colonneMiroir);
  }
}


// Fonction pour afficher ou éteindre les deux points 
void afficherDeuxPoints(bool etat) {
  // Point 1 : ligne 5, colonne 0
  lc.setLed(2, 5, 6, etat);

  // Point 2 : ligne 6, colonne 0
  lc.setLed(2, 2, 6, etat);
}

// Fonction d'initialisation des matrices
void initialiserMatrices() {
  for (int i = 0; i < 4; i++) {
    lc.shutdown(i, false); // Désactiver mode économie d'énergie
    lc.setIntensity(i, 8); // Réglage de la luminosité (0-15)
    lc.clearDisplay(i);    // Effacer l'affichage initial
  }
}

// Fonction d'initialisation du module RTC
void initialiserRTC() {
  if (!rtc.begin()) {
    while (1); // Bloquer si le module RTC n'est pas détecté
  }

  if (!rtc.isrunning()) {
    rtc.adjust(DateTime(F(__DATE__), F(__TIME__))); // Synchroniser l'heure avec le PC
  }
}

void setup() {
  u8g.setColorIndex(1);  // set the color to white
  pinMode(Bouton_haut, INPUT_PULLUP); // up button
  pinMode(Bouton_choix, INPUT_PULLUP); // select button
  pinMode(Bouton_bas, INPUT_PULLUP); // down button
  initialiserMatrices(); // Initialiser les matrices
  initialiserRTC();      // Initialiser le module RTC

}


void loop() {
  if (actuel == 0) { // MENU 

      // up and down buttons only work for the menu screen
      if ((digitalRead(Bouton_haut) == LOW) && (Bouton_haut_cliquer == 0)) { // up button clicked - jump to previous menu item
        choix_select = choix_select - 1; // selectionner avant
        Bouton_haut_cliquer = 1; // cliquer
        if (choix_select < 0) { // retour en bas
          choix_select = nb_choix-1;
        }
      }
      else if ((digitalRead(Bouton_bas) == LOW) && (Bouton_bas_cliquer == 0)) { // down button clicked - jump to next menu item
        choix_select = choix_select + 1; // select next item
        Bouton_bas_cliquer = 1; // set button to clicked to only perform the action once
        if (choix_select >= nb_choix) { // last item was selected, jump to first menu item
          choix_select = 0;
          }
      } 

      if ((digitalRead(Bouton_haut) == HIGH) && (Bouton_haut_cliquer == 1)) { // unclick 
        Bouton_haut_cliquer = 0;
      }
      if ((digitalRead(Bouton_bas) == HIGH) && (Bouton_bas_cliquer == 1)) { // unclick
        Bouton_bas_cliquer = 0;
      }

  }

  if ((digitalRead(Bouton_choix) == LOW) && (Bouton_choix_cliquer == 0)) {
     Bouton_choix_cliquer = 1; 
     if (actuel == 0) {actuel = 1;} 
     else if (actuel == 1) {actuel = 2;} 
     else {actuel = 0;} 
  }
  if ((digitalRead(Bouton_choix) == HIGH) && (Bouton_choix_cliquer == 1)) { 
    Bouton_choix_cliquer = 0;
  }

  choisit_avant = choix_select - 1;
  if (choisit_avant < 0) {choisit_avant = nb_choix - 1;} // selection avant sera avant
  choisit_apres = choix_select + 1;  
  if (choisit_apres >= nb_choix) {choisit_apres = 0;} // selection d'apres sera apres


  u8g.firstPage(); 
  do {

    if (actuel == 0) { // MENU

      // rectangle selectionner
      u8g.drawBitmapP(0, 22, 128/8, 21, rectangle_select);

      // rectangle avant
      u8g.setFont(u8g_font_7x14);
      u8g.drawStr(25, 15, menu_choix[choisit_avant]);

      // beau rectangle + selection en gras
      u8g.setFont(u8g_font_7x14B);    
      u8g.drawStr(25, 15+20+2, menu_choix[choix_select]);

      // rectangle apres
      u8g.setFont(u8g_font_7x14);     
      u8g.drawStr(25, 15+20+20+2+2, menu_choix[choisit_apres]);
    }

  // Récupérer l'heure actuelle depuis le RTC
  DateTime now = rtc.now();

  // Séparer les heures et les minutes
  int heureDizaines = now.hour() / 10;
  int heureUnites = now.hour() % 10;
  int minuteDizaines = now.minute() / 10;
  int minuteUnites = now.minute() % 10;

  // Afficher les chiffres sur les matrices
  afficherChiffre(0, minuteUnites);    // Matrice 1 : Unités des minutes
  afficherChiffre(1, minuteDizaines); // Matrice 2 : Dizaines des minutes
  afficherChiffre(2, heureUnites);    // Matrice 3 : Unités des heures
  afficherChiffre(3, heureDizaines);  // Matrice 4 : Dizaines des heures

  // Faire clignoter les deux points
  afficherDeuxPoints(true);  // Allumer les deux points
  delay(500);                // Attendre 500ms
  afficherDeuxPoints(false); // Éteindre les deux points
  delay(500);                // Attendre 500ms


  } while ( u8g.nextPage() ); 
}
